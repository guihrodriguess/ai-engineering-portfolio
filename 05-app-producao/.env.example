# Postgres local (docker compose up -d db).
# DATABASE_URL: role da aplicação (app_user, sem BYPASSRLS — RLS vale de verdade).
# DATABASE_URL_ADMIN: só pra migrations (drizzle-kit / npm run db:migrate) — nunca usada em runtime da app.
DATABASE_URL=postgres://app_user:app_user_dev_only@localhost:5432/app_producao
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/app_producao

# Vercel AI Gateway — necessário pra classificação real (sem ela, cai no fallback heurístico).
AI_GATEWAY_API_KEY=
CLASSIFICACAO_MODEL=anthropic/claude-haiku-4-5
