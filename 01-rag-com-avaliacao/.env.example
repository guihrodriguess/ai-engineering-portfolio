# Vercel AI Gateway — necessário para o modo real (embeddings + rerank + geração).
# Gere uma chave em https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Modelo de embedding usado na etapa de retrieval.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Modelo usado no rerank (etapa 2) e na geração da resposta final (etapa 4).
RERANK_MODEL=anthropic/claude-haiku-4-5
GERACAO_MODEL=anthropic/claude-haiku-4-5
