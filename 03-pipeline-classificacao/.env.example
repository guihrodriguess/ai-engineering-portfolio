# Vercel AI Gateway — necessário para o modo real (embeddings + rerank).
# Gere uma chave em https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Modelo de embedding usado na geração de candidatos (etapa 1).
EMBEDDING_MODEL=openai/text-embedding-3-small

# Modelo usado no rerank (etapa 2) — barato/rápido de propósito, decide só
# entre o shortlist já reduzido pela etapa de embedding.
RERANK_MODEL=anthropic/claude-haiku-4-5
